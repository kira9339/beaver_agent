# Application Settings
APP_NAME="Beaver"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# # Database Configuration (you can set it to override the default database configuration)
# DATABASE_URL="sqlite:////absolute/path/to/your/project/beaver_assistant.db"
# For PostgreSQL: postgresql://user:password@localhost/beaver_assistant

# # Question Value Algorithm Parameters (current not used, but may be used in the future)
# QUESTION_VALUE_THRESHOLD=0.8
# QUESTION_VALUE_ALPHA=0.05
# QUESTION_VALUE_BETA=1.0
# QUESTION_VALUE_DECAY=0.5
# QUESTION_VALUE_MAX=10.0

# # Preference Merging (current not used, but may be used in the future)
# PREFERENCE_MERGE_THRESHOLD=10
# PREFERENCE_SIMILARITY_THRESHOLD=0.75

# # Context Management (current not used, but may be used in the future)
# MAX_ACTIVE_MESSAGES=20
# CONTEXT_WINDOW_SIZE=4000
# # Background Tasks
# DAILY_REPORT_TIME="09:00"
# REMINDER_CHECK_INTERVAL=60
# QUESTION_VALUE_UPDATE_INTERVAL=300
# PREFERENCE_MERGE_INTERVAL=3600